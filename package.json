    "@fastify/static": "^7",
    "connect-redis": "^9.0.0",
    "fastify": "^4",
    "ioredis": "^5",
    "resend": "^3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.1.6",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
