{
  "name": "vouchflow-web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "playwright test",
    "audit:public": "playwright test audit/public-pages.spec.ts",
